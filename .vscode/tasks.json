{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Frontend",
      "type": "shell",
      "command": "npm run dev:frontend",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "presentation": {
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "type": "npm",
      "script": "dev",
      "group": "build",
      "label": "npm: dev",
      "presentation": {
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "isBackground": true
    },
    {
      "label": "Lint: Frontend",
      "type": "shell",
      "command": "npm run lint",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test"
    }
  ]
}
